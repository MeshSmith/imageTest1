# pi-gen config (Bookworm Lite)

IMG_NAME="pimesh-custom"
RELEASE="bookworm"
DEPLOY_COMPRESSION="xz"
LOCALE_DEFAULT="en_US.UTF-8"
TIMEZONE_DEFAULT="America/New_York"
KEYBOARD_KEYMAP="us"

# Build a Lite image (no desktop)
ENABLE_SSH=1

# Username/password on first boot (you can also use userconf)
FIRST_USER_NAME="pi"
FIRST_USER_PASS="raspberry"

# What stages to build:
# stage0, stage1, stage2 = lite base
# then your custom stage
STAGE_LIST="stage0 stage1 stage2 stage-meshsmith"
